				"to": "00:02:56,470"
			},
			"offsets": {
				"from": 175470,
				"to": 176470
			},
			"text": "じゃあその作業か。"
		},
		{
			"timestamps": {
				"from": "00:02:56,470",
				"to": "00:03:02,470"
			},
			"offsets": {
				"from": 176470,
				"to": 182470
			},
			"text": "本当にどれくらいの作業なものなのかって言うと、割と、あの、ものを見て、"
		},
		{
			"timestamps": {
