				"to": "00:02:31,880"
			},
			"offsets": {
				"from": 150880,
				"to": 151880
			},
			"text": "うん。"
		},
		{
			"timestamps": {
				"from": "00:02:31,880",
				"to": "00:02:40,880"
			},
			"offsets": {
				"from": 151880,
				"to": 160880
			},
			"text": "えーと、まあだから、割と特殊な部分とかもあったりとかして、まあいろんな人の、えーと、例えば見積もりの情報もらったりとか、"
		},
		{
			"timestamps": {
